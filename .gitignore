# ==============================
# Datasets
# ==============================
dataset/
datasets/
# Whitelist configuration YAMLs while ignoring local image/label data
!dataset/
dataset/*
!dataset/hazards_dataset/
dataset/hazards_dataset/*
!dataset/hazards_dataset/data.yaml
!dataset/custom_dataset.yaml

# ==============================
# Trained model weights
# ==============================
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.weights
*.safetensors
*.bin

# Explicit exceptions for essential production models
!models/best_custom_yolov8n.pt
!runs/detect/runs/detect/hazards_model/weights/best.pt

# ==============================
# YOLO training outputs
# ==============================
wandb/
mlruns/
*.tfevents*

# Exclude YOLO training runs while allowing narrow exception for production hazards model
runs/*
!runs/detect/
runs/detect/*
!runs/detect/runs/
runs/detect/runs/*
!runs/detect/runs/detect/
runs/detect/runs/detect/*
!runs/detect/runs/detect/hazards_model/
runs/detect/runs/detect/hazards_model/*
!runs/detect/runs/detect/hazards_model/weights/
runs/detect/runs/detect/hazards_model/weights/*
!runs/detect/runs/detect/hazards_model/weights/best.pt

